@TeamTaskManager_HostAddress = http://localhost:5151

### 1. Register a Manager
# @name registerManager
POST {{TeamTaskManager_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "userName": "manager_user",
  "fullName": "Manager User",
  "email": "manager@taskmanager.com",
  "role": "Manager",
  "password": "SecurePassword123!"
}

###

### 2. Login as Manager (Retrieve Auth Token)
# @name loginManager
POST {{TeamTaskManager_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "manager@taskmanager.com",
  "password": "SecurePassword123!"
}

### Extract Manager Token
@managerToken = {{loginManager.response.body.data.token}}


### 3. Register an Employee
# @name registerEmployee
POST {{TeamTaskManager_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "userName": "employee_user",
  "fullName": "Employee User",
  "email": "employee@taskmanager.com",
  "role": "Employee",
  "password": "SecurePassword123!"
}

###

### 4. Login as Employee (Retrieve Auth Token and User ID)
# @name loginEmployee
POST {{TeamTaskManager_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "employee@taskmanager.com",
  "password": "SecurePassword123!"
}

### Extract Employee Token and User ID
@employeeToken = {{loginEmployee.response.body.data.token}}
@employeeUserId = {{loginEmployee.response.body.userId}}


### 5. Create a Project (As Manager)
# @name createProject
POST {{TeamTaskManager_HostAddress}}/api/project
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Beta Release",
  "description": "Project tasks for the upcoming Beta launch"
}

### Extract Project ID
@projectId = {{createProject.response.body.id}}


### 6. Create a Task under the Project (As Manager)
# @name createTask
POST {{TeamTaskManager_HostAddress}}/api/task
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "title": "Setup CI/CD Pipeline",
  "description": "Configure GitHub Actions or Azure DevOps pipeline",
  "projectId": "{{projectId}}"
}

### Extract Task ID
@taskId = {{createTask.response.body.id}}


### 7. Assign the Task to the Employee (As Manager)
# @name assignTask
POST {{TeamTaskManager_HostAddress}}/api/task/assign
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "assignedUserId": "{{employeeUserId}}",
  "taskId": "{{taskId}}"
}


### 8. View Tasks assigned to the Employee (As Employee)
# @name getEmployeeTasks
GET {{TeamTaskManager_HostAddress}}/api/user-tasks
Authorization: Bearer {{employeeToken}}
Accept: application/json


### 9. Mark Task as Done (As Employee)
# @name markTaskDone
PUT {{TeamTaskManager_HostAddress}}/api/user-tasks/mark?taskId={{taskId}}
Authorization: Bearer {{employeeToken}}
Accept: application/json
